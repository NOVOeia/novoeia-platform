# Frontend (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Edge Functions / Deno secrets
# Set these with: supabase secrets set KEY=value
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=http://localhost:5173/
GHL_SCOPES=users.readonly locations.readonly companies.readonly
# Comma-separated emails that become super_admin after GHL login
GHL_SUPER_ADMIN_EMAILS=tu@email.com

# Stripe + app URL (Supabase Edge Functions secrets)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PUBLIC_APP_URL=http://localhost:5173

# Stripe publishable key (frontend — mismo modo test/live que STRIPE_SECRET_KEY)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
