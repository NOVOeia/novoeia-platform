# Frontend (Vite) — bootstrap del cliente Supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Edge Functions — fallback opcional si no usas el panel Configuración
# Preferir: Super Admin → Configuración (GHL, Stripe, App y Webhooks)
# Set with: supabase secrets set KEY=value

# GHL OAuth fallback
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=http://localhost:5173/
GHL_SCOPES=users.readonly locations.readonly locations.write companies.readonly saas/company.read saas/company.write saas/location.write
GHL_SUPER_ADMIN_EMAILS=tu@email.com

# GHL provisioning fallback
GHL_SAAS_ENABLED=false
GHL_SAAS_V2=true
GHL_DEFAULT_TIMEZONE=America/New_York
GHL_DEFAULT_SAAS_PLAN_ID=
GHL_DEFAULT_SAAS_PRICE_ID=

# Stripe fallback
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App URL fallback
PUBLIC_APP_URL=http://localhost:5173

# Email fallback (preferir panel → Configuración → Correo)
EMAIL_TRANSPORT=api
EMAIL_API_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=NOVO
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USER=
SMTP_PASSWORD=
MAILGUN_DOMAIN=

# Frontend Stripe fallback legacy (opcional)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
